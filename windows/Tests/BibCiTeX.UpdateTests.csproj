<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj/updates/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>obj/updates/</MSBuildProjectExtensionsPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputPath>bin/updates/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="UpdateTestProgram.cs" />
    <Compile Include="UpdatePolicyTests.cs" />
    <Compile Include="UpdateFeedTests.cs" />
    <Compile Include="UpdateSourceTests.cs" />
    <Compile Include="../BibCiTeX/UpdatePolicy.cs" Link="UpdatePolicy.cs" />
    <Compile Include="../BibCiTeX/UpdateFeed.cs" Link="UpdateFeed.cs" />
    <Compile Include="../BibCiTeX/UpdateSource.cs" Link="UpdateSource.cs" />
    <Compile Include="../BibCiTeX/NativeSettings.cs" Link="NativeSettings.cs" />
    <Compile Include="../BibCiTeX/UpdateActivity.cs" Link="UpdateActivity.cs" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
