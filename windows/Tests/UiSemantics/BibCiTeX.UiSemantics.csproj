<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" ExcludeAssets="build;buildTransitive;runtime;native" />
    <PackageReference Include="CSharpMath.SkiaSharp" Version="0.5.1" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <Compile Include="../../BibCiTeX/*.cs" Link="Application/%(Filename)%(Extension)" />
    <Compile Include="../../../bindings/generated/csharp/*.cs" Link="Generated/%(Filename)%(Extension)" />
    <Compile Include="XamlCompilationBoundary.cs" />
  </ItemGroup>
</Project>
