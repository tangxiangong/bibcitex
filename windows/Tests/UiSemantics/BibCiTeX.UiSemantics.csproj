<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GeneratedBindingsDirectory Condition="'$(GeneratedBindingsDirectory)' == ''">$(MSBuildThisFileDirectory)../../../bindings/generated/csharp</GeneratedBindingsDirectory>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" ExcludeAssets="build;buildTransitive;runtime;native" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" ExcludeAssets="build;buildTransitive;runtime;native" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" ExcludeAssets="build;buildTransitive;runtime;native" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="CSharpMath.SkiaSharp" Version="0.5.1" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <Compile Include="../../BibCiTeX/*.cs" Link="Application/%(Filename)%(Extension)" />
    <Compile Include="$(GeneratedBindingsDirectory)/*.cs" Link="Generated/%(Filename)%(Extension)" />
    <Compile Include="XamlCompilationBoundary.cs" />
    <Compile Include="../NativeLocalizationTests.cs" Link="NativeLocalizationTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../localization/*.json" LogicalName="BibCiTeX.Localization.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
