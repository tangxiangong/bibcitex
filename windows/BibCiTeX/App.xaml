<Application x:Class="BibCiTeX.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
   <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
   </ResourceDictionary.MergedDictionaries>
   <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="{ThemeResource TextFillColorSecondary}" />
   <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="{ThemeResource TextFillColorSecondary}" />
   <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="{ThemeResource TextFillColorPrimary}" />
   <Style x:Key="WorkbenchSidePaneStyle" TargetType="Grid">
    <Setter Property="Background" Value="{ThemeResource LayerOnMicaBaseAltFillColorTransparentBrush}" />
   </Style>
   <Style x:Key="WorkbenchContentPaneStyle" TargetType="Grid">
    <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
   </Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
