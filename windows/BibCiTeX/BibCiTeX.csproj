<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>BibCiTeX</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\app-icons\icon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <DefineConstants Condition="'$(LocalizationTestBuild)' == 'true'">$(DefineConstants);LOCALIZATION_TESTS</DefineConstants>
    <DefaultLanguage>en-US</DefaultLanguage>
    <Version>0.7.0</Version>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <!-- Bootstrap only after Velopack hooks and runtime provisioning have completed. -->
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LocalizationTestBuild)' == 'true'">
    <OutputPath>bin/$(Platform)/$(Configuration)/localization-tests/</OutputPath>
    <IntermediateOutputPath>obj/$(Platform)/$(Configuration)/localization-tests/</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="CSharpMath.SkiaSharp" Version="0.5.1" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.153.1" />
    <Content Include="..\..\public\icons\windows\*.svg" Link="Assets\Icons\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Icons\Dark\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\app-icons\icon.ico" Link="Assets\icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\app-icons\tray.ico" Link="Assets\tray.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\app-icons\*.png" Link="Assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\public\favicon.png" Link="Assets\favicon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\public\icons\windows\LICENSE" Link="Assets\Icons\LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)' != 'true' and '$(EnableMsixTooling)' == 'true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup Condition="'$(LocalizationTestBuild)' == 'true'">
    <Compile Include="../Tests/NativeLocalizationTests.cs" Link="Tests/NativeLocalizationTests.cs" />
  </ItemGroup>
  <Import Project="Build/Rust.targets" />
  <ItemGroup>
    <EmbeddedResource Include="../../localization/*.json" LogicalName="BibCiTeX.Localization.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
