{
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ESNext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "nodeModulesDir": "auto",
  "lint": {
    "rules": {
      "exclude": ["no-sloppy-imports"]
    }
  },
  "tasks": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "vite:dev": "vite dev",
    "vite:build": "vite build",
    "vite:preview": "vite preview",
    "check": "tsc --noEmit",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "@tauri-apps/api": "npm:@tauri-apps/api@^2.9.1",
    "@tauri-apps/plugin-clipboard-manager": "npm:@tauri-apps/plugin-clipboard-manager@^2.3.2",
    "@tauri-apps/plugin-dialog": "npm:@tauri-apps/plugin-dialog@^2.4.2",
    "@tauri-apps/plugin-fs": "npm:@tauri-apps/plugin-fs@^2.4.4",
    "@tauri-apps/plugin-global-shortcut": "npm:@tauri-apps/plugin-global-shortcut@^2.3.1",
    "@tauri-apps/plugin-opener": "npm:@tauri-apps/plugin-opener@^2.5.2",
    "@tauri-apps/plugin-process": "npm:@tauri-apps/plugin-process@^2.3.1",
    "@tauri-apps/plugin-updater": "npm:@tauri-apps/plugin-updater@^2.9.0",
    "react": "npm:react@^19.2.3",
    "react-dom": "npm:react-dom@^19.2.3",
    "react-router-dom": "npm:react-router-dom@^7.11.0",
    "katex": "npm:katex@^0.16.27",
    "daisyui": "npm:daisyui@^5.5.14",
    "tailwindcss": "npm:tailwindcss@^4.1.18"
  }
}
