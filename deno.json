{
    "compilerOptions": {
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "strict": true,
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "moduleResolution": "bundler",
        "module": "ESNext",
        "target": "ESNext",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true
    },
    "nodeModulesDir": "auto",
    "tasks": {
        "dev": "tauri dev",
        "build": "tauri build",
        "tauri": "tauri",
        "vite:dev": "vite dev",
        "vite:build": "vite build",
        "vite:preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "fmt": "deno fmt",
        "lint": "deno lint"
    },
    "imports": {
        "@tauri-apps/api": "npm:@tauri-apps/api@^2",
        "@tauri-apps/plugin-clipboard-manager": "npm:@tauri-apps/plugin-clipboard-manager@^2",
        "@tauri-apps/plugin-dialog": "npm:@tauri-apps/plugin-dialog@^2",
        "@tauri-apps/plugin-fs": "npm:@tauri-apps/plugin-fs@^2",
        "@tauri-apps/plugin-global-shortcut": "npm:@tauri-apps/plugin-global-shortcut@^2",
        "@tauri-apps/plugin-opener": "npm:@tauri-apps/plugin-opener@^2",
        "@tauri-apps/plugin-process": "npm:@tauri-apps/plugin-process@^2",
        "@tauri-apps/plugin-updater": "npm:@tauri-apps/plugin-updater@^2",
        "svelte": "npm:svelte@^5",
        "katex": "npm:katex@^0.16",
        "daisyui": "npm:daisyui@^5",
        "tailwindcss": "npm:tailwindcss@^4",
        "@tailwindcss/typography": "npm:@tailwindcss/typography@^0.5"
    }
}
